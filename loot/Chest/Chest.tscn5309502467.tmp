extends Resource

@export_category(\"Loot Table\")
@export var loot_table: LootTable

@export_category(\"Common Loot\")
@export_range(0, 10) var guaranteed_common_items: int = 3

@export_category(\"Bonus Loot Chances\")
@export_range(0.0, 1.0) var uncommon_chance: float = 0.20
@export_range(0.0, 1.0) var rare_chance: float = 0.05

@export_category(\"Bonus Loot\")
@export var uncommon_items: Array[ItemData] = []
@export var rare_items: Array[ItemData] = []
"

